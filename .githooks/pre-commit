#!/bin/sh
# Blocks a commit that stages PII or secrets, or that breaks the project checks.
# Install once per clone with: make hooks   (run from code/)
#
# 0. Nothing under internal/, and no CLAUDE.md, is ever committed. Both are local only.
# 1. The privacy scan of the staged content. Always runs. See tools/scan_private.py.
# 2. `make check` (docs drift, the repository tools' tests, privacy scan of the tree),
#    then `make -C internal check` where that local folder exists.
# 3. `make verify-attestation`, `make lint` and `make test`, only when files under
#    code/ are staged. The attestation check catches an edit to an attested file,
#    even a comment, before CI does.
# Steps 2 and 3 run only where a Makefile exists, so a bare repository that
# borrows this hook (the scanner's own tests do) is not asked for a project.
# There is no bypass variable on purpose. `git commit --no-verify` still skips
# this hook, and the pre-push hook runs the same checks again.
set -e
root=$(git rev-parse --show-toplevel)
if git diff --cached --diff-filter=AMR --name-only | grep -q -E '^(internal/|CLAUDE\.md$)'; then
    echo "blocked: internal/ and CLAUDE.md are local only and must never be committed." >&2
    exit 1
fi
uv run --no-project python "$root/tools/scan_private.py" --staged
if [ -f "$root/Makefile" ]; then
    make -C "$root" --no-print-directory check
    if [ -f "$root/internal/Makefile" ]; then
        make -C "$root/internal" --no-print-directory check
    fi
    if git diff --cached --name-only | grep -q '^code/'; then
        make -C "$root" --no-print-directory verify-attestation
        make -C "$root" --no-print-directory lint
        make -C "$root" --no-print-directory test
    fi
fi
