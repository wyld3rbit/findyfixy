# Copy this file to code/examples/findyfixy/.env and edit it. That file is git-ignored.
# Nothing here is a secret: these are model names.

# The model that answers triage requests (an Ollama tag).
# Qwen3 4B-instruct is the measured choice: see ADR 0005 (code/docs/adr/).
# Set LARGE_MODEL to the same name for one model with no escalation. Give it a
# different name for a two-tier router: low-confidence answers then go to it.
SMALL_MODEL=qwen3:4b-instruct
LARGE_MODEL=qwen3:4b-instruct

# The model that judges answers in the evaluation. Keep it a different family
# from the answering model, so the judge does not favour its own style.
JUDGE_MODEL=qwen2.5:7b

# Tracing to Langfuse (optional). With the local stack running (make obs-up),
# the keys are read from code/infra/langfuse/.env and nothing here is needed.
# TRACING=off                 # off, 0, false or no turns tracing off
# TRACE_USER=local            # who ran it, on every trace
# LANGFUSE_HOST=http://127.0.0.1:3000
# LANGFUSE_PUBLIC_KEY= and LANGFUSE_SECRET_KEY= for another Langfuse: set both here
# LANGFUSE_PROJECT_ID=        # its project id, so the console links each run to its trace
