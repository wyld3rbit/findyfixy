# Copy this file to code/.env and edit it. code/.env is git-ignored.
# Nothing here is a secret: these are model names.

# The model that answers triage requests (an Ollama tag).
# Qwen3 4B-instruct: 25 of 30 severity on the golden set, 4.6 s per case, 2.5 GB.
# Set LARGE_MODEL to the same name for one model with no escalation. Give it a
# different name for a two-tier router: low-confidence answers then go to it.
SMALL_MODEL=qwen3:4b-instruct
LARGE_MODEL=qwen3:4b-instruct

# The model that judges answers in the evaluation. Keep it a different family
# from the answering model, so the judge does not favour its own style.
JUDGE_MODEL=qwen2.5:7b
